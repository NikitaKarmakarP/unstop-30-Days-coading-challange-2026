#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include <unordered_map>

using namespace std;

int main() {
    int N;
    long long K;
    cin >> N >> K;

    unordered_map<long long, long long> freq;

    // Prefix XOR = 0 before the array starts
    freq[0] = 1;

    long long prefixXor = 0;
    long long answer = 0;

    for (int i = 0; i < N; i++) {
        long long x;
        cin >> x;

        prefixXor ^= x;

        // Need previous prefix XOR = prefixXor ^ K
        long long required = prefixXor ^ K;

        if (freq.find(required) != freq.end()) {
            answer += freq[required];
        }

        freq[prefixXor]++;
    }

    cout << answer << '\n';

    return 0;
}

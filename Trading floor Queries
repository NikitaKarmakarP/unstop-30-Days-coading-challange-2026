#include <stdio.h>
#include <stdlib.h>

#define MAXN 200005
#define MAXM 400005

typedef struct {
    char type;
    int a, b;
} Query;

int n, q;
int arr[MAXN];
Query queries[MAXN];

int values[MAXM];
int m = 0;

int bit[MAXM];

int cmp(const void *a, const void *b) {
    int x = *(int *)a;
    int y = *(int *)b;
    if (x < y) return -1;
    if (x > y) return 1;
    return 0;
}

void updateBIT(int idx, int val) {
    while (idx <= m) {
        bit[idx] += val;
        idx += idx & -idx;
    }
}

int queryBIT(int idx) {
    int sum = 0;
    while (idx > 0) {
        sum += bit[idx];
        idx -= idx & -idx;
    }
    return sum;
}

int lowerBound(int x) {
    int l = 0, r = m - 1, ans = m;
    while (l <= r) {
        int mid = (l + r) / 2;
        if (values[mid] >= x) {
            ans = mid;
            r = mid - 1;
        } else {
            l = mid + 1;
        }
    }
    return ans + 1; // 1-based index
}

int upperBound(int x) {
    int l = 0, r = m - 1, ans = -1;
    while (l <= r) {
        int mid = (l + r) / 2;
        if (values[mid] <= x) {
            ans = mid;
            l = mid + 1;
        } else {
            r = mid - 1;
        }
    }
    return ans + 1; // returns 0 if none <= x
}

int kth(int k) {
    int idx = 0;
    int pw = 1;
    while ((pw << 1) <= m) pw <<= 1;

    while (pw) {
        int next = idx + pw;
        if (next <= m && bit[next] < k) {
            k -= bit[next];
            idx = next;
        }
        pw >>= 1;
    }
    return values[idx];
}

int main() {
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        scanf("%d", &arr[i]);
        values[m++] = arr[i];
    }

    scanf("%d", &q);

    for (int i = 0; i < q; i++) {
        scanf(" %c", &queries[i].type);
        if (queries[i].type == 'U') {
            scanf("%d %d", &queries[i].a, &queries[i].b);
            values[m++] = queries[i].b;
        } else {
            scanf("%d", &queries[i].a);
        }
    }

    qsort(values, m, sizeof(int), cmp);

    int sz = 0;
    for (int i = 0; i < m; i++) {
        if (i == 0 || values[i] != values[i - 1])
            values[sz++] = values[i];
    }
    m = sz;

    for (int i = 1; i <= n; i++) {
        updateBIT(lowerBound(arr[i]), 1);
    }

    for (int i = 0; i < q; i++) {
        if (queries[i].type == 'U') {
            int pos = queries[i].a;
            int val = queries[i].b;

            updateBIT(lowerBound(arr[pos]), -1);
            arr[pos] = val;
            updateBIT(lowerBound(arr[pos]), 1);
        } else if (queries[i].type == 'C') {
            int idx = upperBound(queries[i].a);
            if (idx == 0)
                printf("0\n");
            else
                printf("%d\n", queryBIT(idx));
        } else { // K
            printf("%d\n", kth(queries[i].a));
        }
    }

    return 0;
}

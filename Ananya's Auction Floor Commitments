#include <bits/stdc++.h>
using namespace std;

struct Job {
    long long start, end, profit;
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<Job> jobs(n);
    for (int i = 0; i < n; i++) {
        cin >> jobs[i].start >> jobs[i].end >> jobs[i].profit;
    }

    sort(jobs.begin(), jobs.end(), [](Job &a, Job &b) {
        return a.end < b.end;
    });

    vector<long long> ends(n);
    for (int i = 0; i < n; i++)
        ends[i] = jobs[i].end;

    vector<long long> dp(n + 1, 0);

    for (int i = 1; i <= n; i++) {
        int idx = upper_bound(ends.begin(), ends.end(), jobs[i - 1].start) - ends.begin();
        dp[i] = max(dp[i - 1], jobs[i - 1].profit + dp[idx]);
    }

    cout << dp[n] << "\n";
    return 0;
}

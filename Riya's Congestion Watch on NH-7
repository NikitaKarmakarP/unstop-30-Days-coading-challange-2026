#include <bits/stdc++.h>
using namespace std;

using ll = long long;

class SegmentTree {
    int n;
    vector<ll> tree, lazy;

public:
    SegmentTree(const vector<ll>& a) {
        n = (int)a.size() - 1; // 1-indexed
        tree.resize(4 * n + 5);
        lazy.resize(4 * n + 5, 0);
        build(1, 1, n, a);
    }

    void build(int node, int l, int r, const vector<ll>& a) {
        if (l == r) {
            tree[node] = a[l];
            return;
        }

        int mid = (l + r) / 2;

        build(node * 2, l, mid, a);
        build(node * 2 + 1, mid + 1, r, a);

        tree[node] = max(tree[node * 2], tree[node * 2 + 1]);
    }

    void apply(int node, ll val) {
        tree[node] += val;
        lazy[node] += val;
    }

    void push(int node) {
        if (lazy[node] != 0) {
            apply(node * 2, lazy[node]);
            apply(node * 2 + 1, lazy[node]);
            lazy[node] = 0;
        }
    }

    // Add val to [ql, qr]
    void rangeAdd(int node, int l, int r,
                  int ql, int qr, ll val) {

        if (ql <= l && r <= qr) {
            apply(node, val);
            return;
        }

        push(node);

        int mid = (l + r) / 2;

        if (ql <= mid)
            rangeAdd(node * 2, l, mid, ql, qr, val);

        if (qr > mid)
            rangeAdd(node * 2 + 1, mid + 1, r, ql, qr, val);

        tree[node] = max(tree[node * 2], tree[node * 2 + 1]);
    }

    void rangeAdd(int l, int r, ll val) {
        rangeAdd(1, 1, n, l, r, val);
    }

    // Maximum in [ql, qr]
    ll rangeMax(int node, int l, int r,
                int ql, int qr) {

        if (ql <= l && r <= qr)
            return tree[node];

        push(node);

        int mid = (l + r) / 2;

        ll ans = LLONG_MIN;

        if (ql <= mid)
            ans = max(ans,
                      rangeMax(node * 2, l, mid, ql, qr));

        if (qr > mid)
            ans = max(ans,
                      rangeMax(node * 2 + 1, mid + 1, r, ql, qr));

        return ans;
    }

    ll rangeMax(int l, int r) {
        return rangeMax(1, 1, n, l, r);
    }

    // Find the leftmost position in [ql, qr]
    // whose value is > x.
    int firstGreater(int node, int l, int r,
                     int ql, int qr, ll x) {

        // Completely outside query range
        if (r < ql || l > qr)
            return -1;

        // No value in this segment can be > x
        if (tree[node] <= x)
            return -1;

        // Leaf => found the answer
        if (l == r)
            return l;

        push(node);

        int mid = (l + r) / 2;

        // Search left child first because we need
        // the smallest index.
        int ans = firstGreater(
            node * 2, l, mid, ql, qr, x
        );

        if (ans != -1)
            return ans;

        return firstGreater(
            node * 2 + 1, mid + 1, r, ql, qr, x
        );
    }

    int firstGreater(int l, int r, ll x) {
        return firstGreater(1, 1, n, l, r, x);
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<ll> a(N + 1);

    for (int i = 1; i <= N; i++)
        cin >> a[i];

    SegmentTree st(a);

    int Q;
    cin >> Q;

    while (Q--) {
        int type;
        cin >> type;

        if (type == 1) {
            int l, r;
            ll v;

            cin >> l >> r >> v;

            st.rangeAdd(l, r, v);
        }
        else if (type == 2) {
            int l, r;

            cin >> l >> r;

            cout << st.rangeMax(l, r) << '\n';
        }
        else if (type == 3) {
            int l, r;
            ll x;

            cin >> l >> r >> x;

            cout << st.firstGreater(l, r, x) << '\n';
        }
    }

    return 0;
}

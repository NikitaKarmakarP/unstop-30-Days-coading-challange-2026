#include <stdio.h>
#include <stdlib.h>

int compare(const void *a, const void *b) {
    int *x = (int *)a;
    int *y = (int *)b;

    if (x[1] == y[1])
        return x[0] - y[0];
    return x[1] - y[1];
}

// Max Heap functions
void heapifyUp(int heap[], int idx) {
    while (idx > 0) {
        int parent = (idx - 1) / 2;
        if (heap[parent] >= heap[idx])
            break;
        int temp = heap[parent];
        heap[parent] = heap[idx];
        heap[idx] = temp;
        idx = parent;
    }
}

void heapifyDown(int heap[], int size, int idx) {
    while (1) {
        int largest = idx;
        int left = 2 * idx + 1;
        int right = 2 * idx + 2;

        if (left < size && heap[left] > heap[largest])
            largest = left;
        if (right < size && heap[right] > heap[largest])
            largest = right;

        if (largest == idx)
            break;

        int temp = heap[idx];
        heap[idx] = heap[largest];
        heap[largest] = temp;
        idx = largest;
    }
}

int maximum_repairs(int lighthouses[][2], int n) {
    qsort(lighthouses, n, sizeof(lighthouses[0]), compare);

    int *heap = (int *)malloc(n * sizeof(int));
    int heapSize = 0;
    long long totalTime = 0;

    for (int i = 0; i < n; i++) {
        int t = lighthouses[i][0];
        int d = lighthouses[i][1];

        heap[heapSize] = t;
        heapifyUp(heap, heapSize);
        heapSize++;
        totalTime += t;

        if (totalTime > d) {
            totalTime -= heap[0];
            heap[0] = heap[heapSize - 1];
            heapSize--;
            heapifyDown(heap, heapSize, 0);
        }
    }

    free(heap);
    return heapSize;
}

int main() {
    int n;
    scanf("%d", &n);

    int lighthouses[n][2];

    for (int i = 0; i < n; i++) {
        scanf("%d %d", &lighthouses[i][0], &lighthouses[i][1]);
    }

    printf("%d\n", maximum_repairs(lighthouses, n));

    return 0;
}

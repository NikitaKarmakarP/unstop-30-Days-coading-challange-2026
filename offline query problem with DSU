#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

struct InquiryData {
    int query_index;
    int node_a, node_b;
};

struct Connection {
    int src, dst;
};

class RollbackUnionFind {
private:
    vector<int> parent_map, tree_depth;
    vector<pair<int, int>> state_logs;

public:
    RollbackUnionFind(int total_nodes) {
        parent_map.resize(total_nodes + 1);
        tree_depth.resize(total_nodes + 1, 0);
        for (int idx = 1; idx <= total_nodes; ++idx) {
            parent_map[idx] = idx;
        }
    }

    int get_root(int curr_node) {
        while (curr_node != parent_map[curr_node]) {
            curr_node = parent_map[curr_node];
        }
        return curr_node;
    }

    bool merge_nodes(int first_node, int second_node) {
        int root_a = get_root(first_node);
        int root_b = get_root(second_node);

        if (root_a != root_b) {
            if (tree_depth[root_a] < tree_depth[root_b]) {
                swap(root_a, root_b);
            }
            state_logs.push_back({root_b, parent_map[root_b]});
            parent_map[root_b] = root_a;

            if (tree_depth[root_a] == tree_depth[root_b]) {
                state_logs.push_back({-root_a, tree_depth[root_a]});
                tree_depth[root_a]++;
            }
            return true;
        }
        return false;
    }

    int get_checkpoint() const {
        return static_cast<int>(state_logs.size());
    }

    void restore_state(int checkpoint_mark) {
        while (static_cast<int>(state_logs.size()) > checkpoint_mark) {
            auto top_change = state_logs.back();
            state_logs.pop_back();

            if (top_change.first < 0) {
                int target = -top_change.first;
                tree_depth[target] = top_change.second;
            } else {
                int target = top_change.first;
                parent_map[target] = top_change.second;
            }
        }
    }
};

struct PactRecord {
    int start_node, end_node;
    int validity_start, validity_end;
};

struct AskRecord {
    int kingdom1, kingdom2;
    int point_in_time;
};

int kingdom_count, treaty_count, query_count;
vector<vector<Connection>> tree_buckets;
vector<vector<InquiryData>> bucket_queries;
vector<bool> query_results;

void map_interval_edge(int tree_idx, int range_l, int range_r, int target_l, int target_r, Connection conn) {
    if (target_l <= range_l && range_r <= target_r) {
        tree_buckets[tree_idx].push_back(conn);
        return;
    }
    int mid_point = range_l + (range_r - range_l) / 2;
    if (target_l <= mid_point) {
        map_interval_edge(2 * tree_idx, range_l, mid_point, target_l, target_r, conn);
    }
    if (target_r > mid_point) {
        map_interval_edge(2 * tree_idx + 1, mid_point + 1, range_r, target_l, target_r, conn);
    }
}

void process_tree(int tree_idx, int range_l, int range_r, RollbackUnionFind& uf_structure) {
    int state_marker = uf_structure.get_checkpoint();

    for (const auto& conn : tree_buckets[tree_idx]) {
        uf_structure.merge_nodes(conn.src, conn.dst);
    }

    if (range_l == range_r) {
        for (const auto& inq : bucket_queries[range_l]) {
            uf_structure.get_root(inq.node_a) == uf_structure.get_root(inq.node_b)
                ? query_results[inq.query_index] = true
                : query_results[inq.query_index] = false;
        }
    } else {
        int mid_point = range_l + (range_r - range_l) / 2;
        process_tree(2 * tree_idx, range_l, mid_point, uf_structure);
        process_tree(2 * tree_idx + 1, mid_point + 1, range_r, uf_structure);
    }

    uf_structure.restore_state(state_marker);
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    if (!(cin >> kingdom_count)) return 0;
    cin >> treaty_count;

    vector<PactRecord> pacts(treaty_count);
    vector<int> temporal_stamps;

    for (int idx = 0; idx < treaty_count; ++idx) {
        cin >> pacts[idx].start_node >> pacts[idx].end_node 
            >> pacts[idx].validity_start >> pacts[idx].validity_end;
        temporal_stamps.push_back(pacts[idx].validity_start);
        temporal_stamps.push_back(pacts[idx].validity_end);
    }

    cin >> query_count;
    vector<AskRecord> asks(query_count);
    for (int idx = 0; idx < query_count; ++idx) {
        cin >> asks[idx].kingdom1 >> asks[idx].kingdom2 >> asks[idx].point_in_time;
        temporal_stamps.push_back(asks[idx].point_in_time);
    }

    sort(temporal_stamps.begin(), temporal_stamps.end());
    temporal_stamps.erase(unique(temporal_stamps.begin(), temporal_stamps.end()), temporal_stamps.end());

    int total_time_slots = static_cast<int>(temporal_stamps.size());
    if (total_time_slots == 0) return 0;

    tree_buckets.resize(4 * total_time_slots + 5);
    bucket_queries.resize(total_time_slots + 5);
    query_results.resize(query_count);

    for (int idx = 0; idx < treaty_count; ++idx) {
        int left_bound = lower_bound(temporal_stamps.begin(), temporal_stamps.end(), pacts[idx].validity_start) - temporal_stamps.begin() + 1;
        int right_bound = lower_bound(temporal_stamps.begin(), temporal_stamps.end(), pacts[idx].validity_end) - temporal_stamps.begin() + 1;
        map_interval_edge(1, 1, total_time_slots, left_bound, right_bound, {pacts[idx].start_node, pacts[idx].end_node});
    }

    for (int idx = 0; idx < query_count; ++idx) {
        int position_idx = lower_bound(temporal_stamps.begin(), temporal_stamps.end(), asks[idx].point_in_time) - temporal_stamps.begin() + 1;
        bucket_queries[position_idx].push_back({idx, asks[idx].kingdom1, asks[idx].kingdom2});
    }

    RollbackUnionFind solver_uf(kingdom_count);
    process_tree(1, 1, total_time_slots, solver_uf);

    for (int idx = 0; idx < query_count; ++idx) {
        if (query_results[idx]) {
            cout << "YES\n";
        } else {
            cout << "NO\n";
        }
    }

    return 0;
}
